videoFile2.mp4
videoFile3.mp4
#EXTINF:0,Subdir Example
subdir/videoFile4.mp4
#EXTINF:0,Repeat example (from filename)
subdir/videoFile5_repeat_2x.mp4
#EXTINF:0,Include child playlist
example_child.m3u
